{
  "name": "restaurant-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode live --host localhost --port 5173",
    "dev:demo": "node tools/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:live": "vite --mode live --host localhost --port 5173",
    "demo:server": "node demo/server.mjs",

    "test:client": "node --experimental-strip-types --test tests/*.client.mts",
    "check": "npm run lint && npm run test && npm run test:client && npm run build",
    "test:ui": "node tests/ui.smoke.mjs",
    "demo:reset": "node tools/reset-demo.mjs",
    "test:native": "node --test tests/native-contract.test.mjs",
    "check:syntax": "node tools/check-syntax.cjs"
  },
  "dependencies": {
